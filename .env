# ===== FBF (Node) - copie para .env e preencha =====
# Porta / host
PORT=8080
HOST=0.0.0.0

# URL publica do site (sem barra no final). Se comecar com https, o cookie de sessao vai com Secure.
FBF_BASE_URL=https://seu-dominio.com.br

# Login Discord (use os valores do portal https://discord.com/developers/applications)
FBF_DISCORD_CLIENT_ID=1512438255629504582
FBF_DISCORD_CLIENT_SECRET=f5dK-wTvPkO0zd1BX96Zk5KRknx-Gy3l
# Precisa ser IDENTICO ao Redirect cadastrado no Discord. Vazio = BASE_URL + /auth/discord/callback
FBF_DISCORD_CALLBACK_URL=http://localhost:8080/auth/discord/callback
# IDs do Discord que viram admin (separados por virgula)
FBF_DISCORD_ADMIN_IDS=701134406957400114

# Webhooks do Discord (opcionais): avisos de pedidos Pix e de cartas Icon
FBF_DISCORD_WEBHOOK_URL=
FBF_DISCORD_ICON_WEBHOOK_URL=

# Login de teste sem Discord (NUNCA ligue em producao)
FBF_DEV_LOGIN=false

# Moedas de boas-vindas
FBF_INITIAL_COINS=1000

# Sessao
FBF_SESSION_COOKIE=fbf_sid
FBF_SESSION_DAYS=7

# Banco SQLite e uploads
FBF_DB_PATH=./data/fbf.sqlite
FBF_UPLOAD_DIR=./uploads

# Importa dados iniciais (raridades, modelos, pacotes...) na 1a execucao
FBF_SEED_ENABLED=true
