# =====================================================================
#  FBF Football Draft - configuracao (equivalente ao application.properties)
#  Carregado automaticamente em src/server.js (parser proprio, sem dependencia).
# =====================================================================

PORT=8080

# Banco SQLite embutido (node:sqlite). Arquivo relativo a raiz do projeto.
FBF_DB_FILE=data/fbf.sqlite

# Importa jogadores/times/raridades/modelos/pacotes na 1a execucao (idempotente).
FBF_SEED_ENABLED=true

# Uploads (fotos de jogadores, comprovantes Pix, imagens dos modelos)
FBF_UPLOAD_DIR=uploads

# Sessao / login
FBF_SESSION_COOKIE=fbf_sid
FBF_SESSION_DAYS=7

