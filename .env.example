# Copie para .env e preencha. Valores em branco desativam o recurso.
PORT=8080
FBF_DB_FILE=data/fbf.sqlite
FBF_SEED_ENABLED=true
FBF_UPLOAD_DIR=uploads
FBF_SESSION_COOKIE=fbf_sid
FBF_SESSION_DAYS=7

# Use a URL publica (com https) em producao; local pode ser http://localhost:8080/
FBF_BASE_URL=http://localhost:8080/

# Credenciais do app do Discord (Developer Portal > OAuth2).
# Atencao: cole SEM espacos/aspas/\r invisiveis para nao dar invalid_client.
FBF_DISCORD_CLIENT_ID=
FBF_DISCORD_CLIENT_SECRET=
# Redirect URI: precisa estar cadastrada IGUAL no Developer Portal.
FBF_DISCORD_CALLBACK_URL=http://localhost:8080/auth/discord/callback

# IDs do Discord que viram admin (separados por virgula).
FBF_DISCORD_ADMIN_IDS=

# Webhooks opcionais (deixe vazio para desativar).
FBF_DISCORD_WEBHOOK_URL=
FBF_DISCORD_ICON_WEBHOOK_URL=

# Login de desenvolvimento (cria/usa um usuario sem Discord). So fora de producao.
FBF_DEV_LOGIN=false
FBF_INITIAL_COINS=1000
